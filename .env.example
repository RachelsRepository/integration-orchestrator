# Integration Orchestrator - example environment configuration.
#
# Copy to .env for local development:  cp .env.example .env
#
# Every value in this file is a non-functional local placeholder. Real credentials
# must never be committed. In deployed environments these values are injected from
# a secrets manager (see docs/deployment.md).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=local
SERVICE_NAME=integration-orchestrator
LOG_LEVEL=INFO
# Emit human-readable logs instead of JSON. Never enable outside local development.
LOG_CONSOLE_RENDERER=false

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DATABASE__URL=postgresql+asyncpg://orchestrator:orchestrator@localhost:5432/orchestrator
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=5
DATABASE__POOL_TIMEOUT_SECONDS=10
DATABASE__ECHO=false

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS__URL=redis://localhost:6379/0
REDIS__SOCKET_TIMEOUT_SECONDS=2.0
REDIS__NAMESPACE=integration-orchestrator

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
KAFKA__ENABLED=true
KAFKA__BOOTSTRAP_SERVERS=localhost:9092
KAFKA__TOPIC_PREFIX=integration
KAFKA__CLIENT_ID=integration-orchestrator
KAFKA__REQUEST_TIMEOUT_SECONDS=10.0
KAFKA__ACKS=all

# ---------------------------------------------------------------------------
# Internal API authentication (JWT bearer tokens)
#
# HS256 is the local default because it needs no key material on disk. Deployed
# environments should use RS256 with keys sourced from a secrets manager.
# ---------------------------------------------------------------------------
JWT__ALGORITHM=HS256
JWT__ISSUER=https://auth.local.integration-orchestrator.test
JWT__AUDIENCE=integration-orchestrator
JWT__SECRET=local-development-signing-secret-not-for-production
JWT__LEEWAY_SECONDS=10
# Only used when JWT__ALGORITHM=RS256
# JWT__PUBLIC_KEY_PATH=/etc/orchestrator/jwt-public.pem

# ---------------------------------------------------------------------------
# Provider sandbox
#
# The sandbox hosts deterministic fake implementations of the three fictional
# providers. It exists so the adapters exercise real HTTP behaviour locally.
# In a deployed environment these base URLs point at the real providers and the
# sandbox is not deployed at all.
# ---------------------------------------------------------------------------
PROVIDER_SANDBOX__ENABLED=true
PROVIDER_SANDBOX__MOUNT_IN_APP=true

# ---------------------------------------------------------------------------
# Provider: Northstar Connect (OAuth2 client credentials)
# ---------------------------------------------------------------------------
PROVIDERS__NORTHSTAR__ENABLED=true
PROVIDERS__NORTHSTAR__BASE_URL=http://localhost:8000/__sandbox__/northstar
PROVIDERS__NORTHSTAR__OAUTH_TOKEN_URL=http://localhost:8000/__sandbox__/northstar/oauth/token
PROVIDERS__NORTHSTAR__CLIENT_ID=northstar-local-client
PROVIDERS__NORTHSTAR__CLIENT_SECRET=northstar-local-secret
PROVIDERS__NORTHSTAR__WEBHOOK_SECRET=northstar-local-webhook-secret
PROVIDERS__NORTHSTAR__TOTAL_TIMEOUT_SECONDS=6.0
PROVIDERS__NORTHSTAR__CONNECT_TIMEOUT_SECONDS=2.0
PROVIDERS__NORTHSTAR__MAX_ATTEMPTS=4
PROVIDERS__NORTHSTAR__MAX_CONCURRENCY=16
PROVIDERS__NORTHSTAR__RATE_LIMIT_PER_SECOND=25
PROVIDERS__NORTHSTAR__CIRCUIT_FAILURE_THRESHOLD=5
PROVIDERS__NORTHSTAR__CIRCUIT_OPEN_SECONDS=30

# ---------------------------------------------------------------------------
# Provider: Meridian Services (API key)
# ---------------------------------------------------------------------------
PROVIDERS__MERIDIAN__ENABLED=true
PROVIDERS__MERIDIAN__BASE_URL=http://localhost:8000/__sandbox__/meridian
PROVIDERS__MERIDIAN__API_KEY=meridian-local-api-key
PROVIDERS__MERIDIAN__WEBHOOK_SECRET=meridian-local-webhook-secret
PROVIDERS__MERIDIAN__TOTAL_TIMEOUT_SECONDS=5.0
PROVIDERS__MERIDIAN__CONNECT_TIMEOUT_SECONDS=2.0
PROVIDERS__MERIDIAN__MAX_ATTEMPTS=3
PROVIDERS__MERIDIAN__MAX_CONCURRENCY=8
PROVIDERS__MERIDIAN__RATE_LIMIT_PER_SECOND=10
PROVIDERS__MERIDIAN__CIRCUIT_FAILURE_THRESHOLD=5
PROVIDERS__MERIDIAN__CIRCUIT_OPEN_SECONDS=45

# ---------------------------------------------------------------------------
# Provider: Cobalt Network (OAuth2 client credentials, Ed25519 signed webhooks)
# ---------------------------------------------------------------------------
PROVIDERS__COBALT__ENABLED=true
PROVIDERS__COBALT__BASE_URL=http://localhost:8000/__sandbox__/cobalt
PROVIDERS__COBALT__OAUTH_TOKEN_URL=http://localhost:8000/__sandbox__/cobalt/oauth/token
PROVIDERS__COBALT__CLIENT_ID=cobalt-local-client
PROVIDERS__COBALT__CLIENT_SECRET=cobalt-local-secret
# Ed25519 public key (base64, raw 32 bytes) used to verify Cobalt webhook signatures.
# This is the public half of the deterministic sandbox key and is not a secret.
PROVIDERS__COBALT__WEBHOOK_PUBLIC_KEY=lySCb9L+MRe1IRjHP9/7MuZTTxyeIZPaEg6v623YYF4=
PROVIDERS__COBALT__TOTAL_TIMEOUT_SECONDS=8.0
PROVIDERS__COBALT__CONNECT_TIMEOUT_SECONDS=2.0
PROVIDERS__COBALT__MAX_ATTEMPTS=4
PROVIDERS__COBALT__MAX_CONCURRENCY=12
PROVIDERS__COBALT__RATE_LIMIT_PER_SECOND=20
PROVIDERS__COBALT__CIRCUIT_FAILURE_THRESHOLD=4
PROVIDERS__COBALT__CIRCUIT_OPEN_SECONDS=60

# ---------------------------------------------------------------------------
# Webhook ingestion
# ---------------------------------------------------------------------------
WEBHOOKS__REPLAY_WINDOW_SECONDS=300
WEBHOOKS__MAX_BODY_BYTES=262144

# ---------------------------------------------------------------------------
# Workers
# ---------------------------------------------------------------------------
WORKERS__OUTBOX_POLL_INTERVAL_SECONDS=1.0
WORKERS__OUTBOX_BATCH_SIZE=100
WORKERS__OUTBOX_MAX_ATTEMPTS=10
WORKERS__RETRY_POLL_INTERVAL_SECONDS=2.0
WORKERS__RETRY_BATCH_SIZE=25
WORKERS__RECONCILIATION_INTERVAL_SECONDS=30.0
WORKERS__RECONCILIATION_BATCH_SIZE=50
WORKERS__RECONCILIATION_STALE_AFTER_SECONDS=300
WORKERS__RECONCILIATION_MANUAL_REVIEW_AFTER_SECONDS=3600
WORKERS__WEBHOOK_DEFERRED_RETRY_SECONDS=15.0
WORKERS__SHUTDOWN_GRACE_SECONDS=15.0

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OBSERVABILITY__TRACING_ENABLED=false
OBSERVABILITY__OTLP_ENDPOINT=http://localhost:4317
OBSERVABILITY__TRACE_SAMPLE_RATIO=1.0
OBSERVABILITY__METRICS_ENABLED=true
